{
  "name": "trigger-knight",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "packageManager": "npm@12.0.2",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "check:architecture": "depcruise --config dependency-cruiser.config.cjs src && npm run check:public-contracts",
    "check:public-contracts": "node build/check-public-contracts.mjs",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "lint": "eslint . --max-warnings 0",
    "setup:browser": "playwright install chromium",
    "test": "npm run test:unit && npm run test:browser",
    "test:unit": "vitest run",
    "test:browser": "playwright test",
    "typecheck": "tsc --noEmit",
    "validate:fast": "node build/run-validation.mjs fast",
    "validate": "node build/run-validation.mjs full"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "@typescript/native": "npm:typescript@7.0.2",
    "dependency-cruiser": "18.2.0",
    "eslint": "10.9.0",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
