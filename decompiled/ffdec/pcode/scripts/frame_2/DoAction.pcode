DefineFunction "saveFile", 0 {
Push "Game Saved!"
Trace
Push "savedata", "/", "tksave", 2, "SharedObject"
GetVariable
Push "getLocal"
CallMethod
SetVariable
Push "savedata"
GetVariable
Push "data"
GetMember
Push "playersave", "playerdata"
GetVariable
SetMember
Push 0.0, "savedata"
GetVariable
Push "flush"
CallMethod
Pop
}
