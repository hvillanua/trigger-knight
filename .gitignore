# Reproducible extracted tools stay local.
/tooling/ffdec-26.2.1/
/tooling/temurin-jre21/
/tooling/ffdec-runtime/

# Large reproducible downloads stay local. Their URLs and hashes are documented.
/tooling/ffdec_26.2.1.zip
/tooling/temurin-jre21-linux-x64.tar.gz
/decompiled/ffdec/swf.xml

# Non-normative comparison SWFs stay local; keep only the primary Kongregate SWF.
/original/comparison/*.swf

# Local operating-system metadata.
.DS_Store
Thumbs.db

# Node.js dependencies and generated application output.
/node_modules/
/dist/
/coverage/
/playwright-report/
/test-results/
/.vite/

# User-installed high-resolution runtime pack. The source and provenance live
# in the public asset experiment repository.
/src/assets/generated/high-res/

# Local visual references and investigation notes.
/.local-references/
